<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- comment -%}
    SEO (Theme settings → SEO & search appearance).
    Home page: the title + description set in theme settings win, so Google shows
    "The Just Adulting Club | Timeless styles…" instead of the bare shop name.
    Other pages keep Shopify's own SEO title/description (editable per product,
    collection and page in Admin → "Search engine listing").
  {%- endcomment -%}
  {%- liquid
    assign seo_title = page_title
    assign seo_description = page_description
    if request.page_type == 'index'
      if settings.seo_home_title != blank
        assign seo_title = settings.seo_home_title
      endif
      if settings.seo_home_description != blank
        assign seo_description = settings.seo_home_description
      endif
    endif
    assign seo_site_name = settings.seo_site_name | default: shop.name
  -%}
  <title>{{ seo_title | escape }}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}</title>
  {%- if seo_description != blank %}
  <meta name="description" content="{{ seo_description | strip_html | escape | truncate: 300 }}">
  {%- endif %}
  <link rel="canonical" href="{{ canonical_url | escape }}">
  {%- comment -%} From the live "JLS SEO fixes" theme: product structured data + noindex on empty collections. {%- endcomment -%}
  {%- if request.page_type == 'product' %}
  <script type="application/ld+json">{{ product | structured_data }}</script>
  {%- endif %}
  {%- if request.page_type == 'collection' and collection.all_products_count == 0 %}
    {%- unless collection.handle == 'sustainability' %}
  <meta name="robots" content="noindex, follow">
    {%- endunless %}
  {%- endif %}
  <meta property="og:site_name" content="{{ seo_site_name | escape }}">
  <meta property="og:title" content="{{ seo_title | escape }}">
  {%- if seo_description != blank %}<meta property="og:description" content="{{ seo_description | strip_html | escape | truncate: 300 }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  {%- if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}

  {%- comment -%} Favicon — Google shows this next to the result (replaces the grey globe). {%- endcomment -%}
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">
  {%- endif %}

  {%- if request.page_type == 'index' -%}
  {%- comment -%} Tells Google the site name (first line of the result) and the logo. {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ seo_site_name | json }},
      "alternateName": ["Just Adulting Club", "Just Adulting"],
      "url": {{ request.origin | append: '/' | json }}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ seo_site_name | json }},
      "url": {{ request.origin | append: '/' | json }},
      "logo": {{ 'favicon.png' | asset_url | prepend: 'https:' | json }}
      {%- assign same_as = '' -%}
      {%- assign social_keys = 'social_instagram,social_facebook,social_pinterest,social_linkedin,social_youtube,social_x' | split: ',' -%}
      {%- for key in social_keys -%}
        {%- if settings[key] != blank -%}{%- assign same_as = same_as | append: '~' | append: settings[key] -%}{%- endif -%}
      {%- endfor -%}
      {%- if same_as != blank -%},
      "sameAs": {{ same_as | remove_first: '~' | split: '~' | json }}
      {%- endif %}
    }
  </script>
  {%- endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
  <script type="module" src="https://cdn.shopify.com/storefront/web-components.js"></script>
  
  {{ content_for_header }}
